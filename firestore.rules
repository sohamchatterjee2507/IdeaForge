rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConfirmedPurchaser(ideaId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/purchases/$(request.auth.uid + "_" + ideaId)) &&
        get(/databases/$(database)/documents/purchases/$(request.auth.uid + "_" + ideaId)).data.status == 'confirmed';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Ideas collection
    match /ideas/{ideaId} {
      allow read: if isAdmin() || resource.data.visible == true;
      allow write: if isAdmin();
    }

    // Private Content
    match /ideaContent/{ideaId} {
      allow read: if isAdmin() || isConfirmedPurchaser(ideaId);
      allow write: if isAdmin();
    }

    // Purchases collection
    match /purchases/{purchaseId} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isAdmin(); 
      allow delete: if isAdmin();
    }
  }
}
